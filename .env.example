# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=

# Never True in production.
DEBUG=True
# Comma-separated. Required once DEBUG is False.
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT signing key -- kept separate from SECRET_KEY on purpose, so rotating one
# doesn't invalidate the other.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

# Optional: leave unset unless sharing cookies across subdomains.
# AUTH_COOKIE_DOMAIN=

# Comma-separated frontend origins. Required for cookie auth to work
# cross-origin -- credentials are allowed, so these must be exact.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email. Defaults to the console backend when DEBUG=True, SMTP otherwise.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Social login. Redirect URIs are the frontend pages that receive ?code=,
# and must match what is registered with the provider exactly.
# Google scopes: openid email. GitHub scopes: read:user user:email.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Required when DEBUG is False. Use a password-protected URL, e.g. redis://:password@host:6379/0
# REDIS_URL=

# Number of reverse proxies in front of the app. Used to find the real client IP for rate limits.
NUM_PROXIES=1

# Admin site path (no leading slash). Change it from the default in production.
ADMIN_URL_PATH=admin/

REDIS_URL=